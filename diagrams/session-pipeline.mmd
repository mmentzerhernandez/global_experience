flowchart TD
    START["Copy the Jira template KAN-1"]:::people
    A["Get the rules and map them to modules"]:::author
    B["Write the outline with minutes and sources"]:::author
    C["Make the hidden bilingual Moodle course"]:::access
    D["Write the English text in CourseFactory v2"]:::author
    G1{{"Does a person approve the English text?"}}:::gate
    E["Write the Spanish text, diagrams and package"]:::author
    F["Load the modules and test the seat time"]:::access
    G["Open every page in both languages"]:::access
    H{{"Does TDLR approve the course?"}}:::gate
    I["Add the website page and test a sale"]:::course

    START --> A --> B --> C --> D --> G1
    G1 -->|"Yes"| E
    G1 -.->|"No"| D
    E --> F --> G --> H
    H -->|"Yes"| I
    H -.->|"No"| A


    classDef people fill:#ECEFF1,stroke:#455A64,color:#000000
    classDef author fill:#F3E5F5,stroke:#6A1B9A,color:#000000
    classDef access fill:#E3F2FD,stroke:#1565C0,color:#000000
    classDef course fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef gate fill:#F9A825,stroke:#7A5200,color:#1A1200,stroke-width:2px
