---
config:
  layout: elk
  theme: base
  themeVariables:
    primaryColor: "#f0f3ff"
    primaryBorderColor: "#001E6E"
    primaryTextColor: "#0F172A"
    lineColor: "#002FA7"
    fontFamily: "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif"
---
graph TD
    classDef trigger fill:#002FA7,stroke:#001E6E,color:#FFFFFF,stroke-width:2.5px,font-weight:bold
    classDef n8n fill:#E5E7EB,stroke:#475569,color:#0F172A,stroke-width:1.5px
    Start((Start)):::trigger --> Q1["Are you sure of your direction?"]:::n8n

    Q1 -->|No| A1["List out goals."]:::n8n
    Q1 -->|Yes| Q2["Are you aware of the project's worst case scenario?"]:::n8n

    Q2 -->|No| A2["Brainstorm problems."]:::n8n
    Q2 -->|Yes| Q3["Can you easily articulate the worst case scenario?"]:::n8n

    Q3 -->|No| A3["Organize your thoughts."]:::n8n
    Q3 -->|Yes| Q4["Have you imagined multiple ways to solve the problems you have listed?"]:::n8n

    Q4 -->|No| A4["Gauge different ideas."]:::n8n
    Q4 -->|Yes| Q5["Are the solutions you listed realistic and helpful to you?"]:::n8n

    Q5 -->|No| A5["Evaluate different options."]:::n8n
    Q5 -->|Yes| Q6["Do you know which solutions should be tried first?"]:::n8n

    Q6 -->|No| A6["Organize your options."]:::n8n
    Q6 -->|Yes| End((Take Action)):::trigger
