---
config:
  theme: base
  themeVariables:
    primaryColor: "#f0f3ff"
    primaryBorderColor: "#002fa7"
    primaryTextColor: "#2c3e50"
    lineColor: "#002fa7"
    fontFamily: "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif"
---
flowchart TD
    n0(["The company is reinstated, TDLR CE Provider 2520"]):::found
    bA["Get the rules for the subject"]:::work
    bB["Write the outline"]:::work
    bC["Make the Moodle course"]:::work
    bD["Write the English text"]:::work
    bG1{{"Does a person approve the text?"}}:::gov
    bE["Write the Spanish text"]:::work
    bF["Test the seat time"]:::work
    bG["Check every page"]:::work
    bH{{"Does TDLR approve the course?"}}:::gov
    bI["Website page and checkout"]:::served
    m1["Free guides, city pages, ads, code cards"]:::work
    m4["ierhub.com brings license holders"]:::served
    k1["License holders and employers buy seats"]:::found
    d1["Pay with Stripe"]:::work
    d2["Check the TDLR license"]:::comply
    d3["Count the seat time"]:::comply
    d4["Send the certificate PDF"]:::served
    c1["Roster to TDLR within 7 days"]:::comply
    c2(["Records kept 2 years, auditor reads"]):::comply

    n0 -->|"applies"| bA --> bB --> bC --> bD --> bG1
    bG1 -->|"Yes"| bE
    bG1 -.->|"No"| bD
    bE --> bF --> bG --> bH
    bH -->|"Yes"| bI
    bH -.->|"No"| fx["Fix the findings and resubmit"]:::work
    fx -.-> bA
    bI --> m4
    m1 --> m4
    m4 --> k1 --> d1 -->|"then"| d2 -->|"then"| d3 -->|"then"| d4
    d4 -->|"completion"| c1 --> c2
    c2 -.->|"renewal, one year later"| k1

    click bD href "#session-pipeline"

    classDef found fill:#ECEFF1,stroke:#455A64,color:#1A2024
    classDef gov fill:#E3F2FD,stroke:#1565C0,color:#0D2B4E,stroke-width:2px
    classDef work fill:#F3E5F5,stroke:#6A1B9A,color:#3B1147
    classDef served fill:#E8F5E9,stroke:#2E7D32,color:#16331A
    classDef comply fill:#FFEBEE,stroke:#C62828,color:#4A1414
    classDef drill fill:#F9A825,stroke:#7A5200,color:#1A1200,stroke-width:2px
