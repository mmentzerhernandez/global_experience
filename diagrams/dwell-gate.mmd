---
config:
  theme: base
  themeVariables:
    primaryColor: "#f0f3ff"
    primaryBorderColor: "#002fa7"
    primaryTextColor: "#2c3e50"
    lineColor: "#002fa7"
    fontFamily: "-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif"
---
flowchart TD
    LEARNER["Learner opens a lesson page"]:::people
    LIC{{"Valid TDLR license selected?"}}:::gate
    LICNO["Course stays closed"]:::refuse
    BEAT["Browser sends a heartbeat every 30 seconds"]:::access
    IDLE{{"Any input in the last 5 minutes?"}}:::gate
    WARN["Warning, then logout one minute later"]:::refuse
    CREDIT["Server counts the time itself"]:::enforce
    NAV["Learner asks for the next page"]:::people
    EXEMPT{{"Teacher or manager role?"}}:::gate
    MET{{"Minimum time for this page met?"}}:::gate
    REFUSE["Server refuses the next page"]:::refuse
    ADVANCE["Next page opens"]:::course
    DONE["Lesson complete at 3,000 seconds"]:::course

    LEARNER --> LIC
    LIC -->|"No"| LICNO
    LIC -->|"Yes"| BEAT
    BEAT --> IDLE
    IDLE -->|"No"| WARN
    IDLE -->|"Yes"| CREDIT
    CREDIT --> NAV
    NAV --> EXEMPT
    EXEMPT -->|"Yes"| ADVANCE
    EXEMPT -->|"No, auditors too"| MET
    MET -->|"No"| REFUSE
    MET -->|"Yes"| ADVANCE
    ADVANCE --> DONE

    classDef people fill:#ECEFF1,stroke:#455A64,color:#000000
    classDef access fill:#E3F2FD,stroke:#1565C0,color:#000000
    classDef course fill:#E8F5E9,stroke:#2E7D32,color:#000000
    classDef enforce fill:#FFF3E0,stroke:#E65100,color:#000000
    classDef refuse fill:#FFEBEE,stroke:#C62828,color:#000000
    classDef gate fill:#F9A825,stroke:#7A5200,color:#1A1200,stroke-width:2px
